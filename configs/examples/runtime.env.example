# Copy outside the repository and set these installation-specific paths.
# SOURCE must match binding.json; credentials remain in RUNTIME/config and data.
export DEPLOY_SOURCE=/absolute/path/to/fixed-source
export DEPLOY_RUNTIME=/absolute/path/to/runtime
export DEPLOY_PYTHON=/absolute/path/to/release-python/bin/python
export DEPLOY_BUN=/absolute/path/to/bun
export OPENSCIENCE_TEST_HOME="$DEPLOY_RUNTIME/home"
export OPENSCIENCE_CONFIG_DIR="$DEPLOY_RUNTIME/config"
export OPENSCIENCE_DATA_DIR="$DEPLOY_RUNTIME/data"
export XDG_CONFIG_HOME="$DEPLOY_RUNTIME/xdg-config"
export XDG_DATA_HOME="$DEPLOY_RUNTIME/xdg-data"
export XDG_CACHE_HOME="$DEPLOY_RUNTIME/cache"
export XDG_STATE_HOME="$DEPLOY_RUNTIME/state"
export COVALENT_RUNTIME_ROOT="$DEPLOY_RUNTIME"
# Match the exact instance registered in this installation's science connection.
export COVALENT_LIGAND_VS_INSTANCE=asgbie4
export COVALENT_PIPELINE_ROOT="$DEPLOY_SOURCE/science"
export COVALENT_POSTPROCESS_PYTHON="$DEPLOY_PYTHON"
export OPENSCIENCE_RDKIT_PYTHON="$DEPLOY_PYTHON"
export COVALENT_APPROVAL_KEY_FILE="$DEPLOY_RUNTIME/config/native-approval.key"
export OPENSCIENCE_DISABLE_PROJECT_CONFIG=true
export OPENSCIENCE_DISABLE_DEFAULT_PLUGINS=true
export OPENSCIENCE_DISABLE_LSP_DOWNLOAD=true
export OPENSCIENCE_DISABLE_SHARE=true
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
export PATH="$(dirname "$DEPLOY_BUN"):$PATH"
unset OPENSCIENCE_CONFIG OPENSCIENCE_CONFIG_CONTENT OPENSCIENCE_RESEARCH_HOST_CATALOG_SHA256
