{
  "$defs": {
    "AssessmentCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "biological_relevance",
            "site_identity",
            "structural_access",
            "ligandability",
            "covalent_precedent",
            "reaction_plausibility",
            "selectivity_window"
          ],
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "challenged",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Weight",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "status",
        "weight",
        "rationale"
      ],
      "title": "AssessmentCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "decision": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "STOP"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Evidence Coverage",
      "type": "number"
    },
    "support_score": {
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Support Score",
      "type": "number"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/AssessmentCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "method": {
      "default": "deterministic-evidence-matrix-v1",
      "title": "Method",
      "type": "string"
    },
    "disclaimer": {
      "default": "This is an evidence-triage decision, not a prediction of clinical efficacy or experimental validation.",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "decision",
    "evidence_coverage",
    "support_score",
    "criteria",
    "blockers",
    "uncertainties"
  ],
  "title": "CovalentAssessment",
  "type": "object"
}
